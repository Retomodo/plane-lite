# plane-lite container environment. Copy to plane-lite.env, fill in, and pass
# with `docker run --env-file plane-lite.env` (or your orchestrator's secrets).

# --- Required ---------------------------------------------------------------
# Long random string; signs sessions, CSRF and password-reset tokens.
SECRET_KEY=
# Managed Postgres (Plane's schema is created on first start). TLS: add ?sslmode=require.
DATABASE_URL=postgres://user:pass@host:5432/plane?sslmode=require
# Shared Redis (cache, throttles, magic codes, live collaboration pub/sub). TLS: rediss://
REDIS_URL=rediss://default:pass@host:6379/0
# Every key and channel the API and live write starts with this.
REDIS_KEY_PREFIX=plane:

# --- Public URL (the nginx site) ----------------------------------------------
WEB_URL=https://plan.rotomodo.com
APP_BASE_URL=https://plan.rotomodo.com
LIVE_BASE_URL=https://plan.rotomodo.com
# https origins make session cookies Secure.
CORS_ALLOWED_ORIGINS=https://plan.rotomodo.com

# --- Sign-in ------------------------------------------------------------------
ENABLE_SIGNUP=1
ENABLE_EMAIL_PASSWORD=1
ENABLE_MAGIC_LINK_LOGIN=1
DISABLE_WORKSPACE_CREATION=0

# --- Email (magic codes, invites, notification digests) -----------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_FROM=Plane <plane@example.com>

# --- File storage: Cloudflare R2 (S3 API) -------------------------------------
# Needed for avatars, project covers, attachments and editor images; without it
# those endpoints answer 503. R2: create a bucket and an API token with Object
# Read & Write on it. Uploads go through the API, so the bucket needs no CORS.
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=plane-lite
AWS_REGION=auto
FILE_SIZE_LIMIT=5242880

# --- Tuning -------------------------------------------------------------------
# Keep under your Postgres plan's connection limit.
DATABASE_MAX_CONNS=10
